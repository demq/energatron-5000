#!/usr/bin/env python3
"""Privacy guard: block personal identifiers and private data from reaching git (D2 §7).

Usage:
  privacy_guard.py --mode {tool,workspace} SOURCE [--denylist-dir DIR | --no-denylist] [--figures]
SOURCE is exactly one of:
  --staged            every added, copied, modified, renamed or type-changed path in the index (the hook mode)
  --commit-msg FILE   the commit message (the commit-msg hook mode)
  --tracked           every path in the index (CI and audits)
  --history           every commit reachable from any ref (its message, patch, changed paths and their new
                      content), every ref name and every annotated tag reachable from a ref
  PATH...             these working-tree files; works outside a git repo, given --denylist-dir or --no-denylist

The denylist directory holds `denylist.generated.txt` (written by `energatron denylist`), the `config.toml` it was
generated from, and an optional hand-written `denylist.txt`. Workspace mode uses `private/`; tool mode reads
`git config energatron.denylist` (relative to the repo root; `none` opts out). Matching is the package's
(`energatron.core.privacy`): case-insensitive, an entry's whitespace normalised with `value.split()`, `word` entries
bounded by anything but a letter, digit, `_` or `-`. Content holding NUL bytes is also searched with them removed,
so ASCII identifiers in UTF-16 text are found (stricter than D2 §7.4).

Output: one line per violation on stderr, then a summary of counts. No line ever holds an entry's value or the
matching text: printed paths are redacted first, and every line passes through the same matcher. `--figures`
prints per-file counts of energy, money and 4-digit figures on stdout, never the figures themselves.
Exit codes: 0 clean, 1 violations, 2 setup error (denylist missing, stale or malformed, bad arguments, git failure).

Stdlib only, so it runs with a bare `python3` before a venv exists. It never imports `energatron`: a broken package
must not disable the guard. Keep it runnable on older Pythons (no 3.10+ syntax).
"""

from __future__ import annotations

import argparse
import bisect
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import NoReturn

GENERATED = "denylist.generated.txt"
MANUAL = "denylist.txt"
CONFIG = "config.toml"
GENERATED_HEADER = "# energatron denylist v1. Generated by `energatron denylist`; do not edit."
SOURCE_PREFIX = "# source-sha256: "
WORD_PREFIX = "word:"
WORD_MIN_SUBSTRING = 5
MATCH_KINDS = ("substring", "word")
REDACTED = "<redacted>"
MAX_BYTES = 5 * 1024 * 1024
DATA_SUFFIXES = frozenset(
    {
        ".csv", ".tsv", ".parquet", ".pdf", ".json", ".jsonl", ".xlsx", ".xls", ".zip", ".png", ".jpg", ".jpeg",
        ".sqlite", ".db", ".duckdb", ".pkl", ".pickle", ".feather", ".arrow",
        # Owner decision 2026-10-29 (a D2 §7.4 deviation): containers the content scan can't see into.
        ".gz", ".bz2", ".xz", ".zst", ".7z", ".tar", ".tgz", ".docx", ".xlsm", ".ods", ".odt",
    }
)  # fmt: skip
REFRESH = "run `uv run energatron denylist` in the workspace"

_SHA256 = re.compile(r"[0-9a-f]{64}")
_WORD_EDGE_BEFORE = r"(?<![0-9A-Za-z_-])"
_WORD_EDGE_AFTER = r"(?![0-9A-Za-z_-])"
_MAX_PASSES = 8
ENERGY_PATTERN = r"\d[\d,]*(\.\d+)?\s*(kWh|MWh|MJ|m3|m³)"  # D2 §7.1; counted by `_energy_count`
_DIGIT_RUN = re.compile(r"[\d,]+")
_ENERGY_TAIL = re.compile(r"(\.\d+)?\s*(kWh|MWh|MJ|m3|m³)")
_MONEY = re.compile(r"\$\s*\d")
_FOUR_DIGITS = re.compile(r"(?<!\d)\d{4}(?!\d)")
_NEWLINE = re.compile("\n")


class SetupError(Exception):
    """A setup problem (exit 2). Its message never holds a denylist value; `line` is a denylist file's line number."""

    def __init__(self, message: str, line: int | None = None) -> None:
        super().__init__(message)
        self.line = line


@dataclass(frozen=True)
class Entry:
    """One denylist entry. `value` never shows in a repr."""

    label: str
    value: str = field(repr=False)
    match: str


# The denylist files


def parse_generated(text: str) -> tuple[str, list[Entry]]:
    """`denylist.generated.txt`: the recorded `source-sha256` and the entries. A bad line → `SetupError`."""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if not lines or lines[0] != GENERATED_HEADER:
        raise SetupError(f"{GENERATED} line 1: not the expected header; {REFRESH}", line=1)
    if (
        len(lines) < 2
        or not lines[1].startswith(SOURCE_PREFIX)
        or not _SHA256.fullmatch(lines[1][len(SOURCE_PREFIX) :])
    ):
        raise SetupError(f"{GENERATED} line 2: no source-sha256; {REFRESH}", line=2)
    entries: list[Entry] = []
    for number, line in enumerate(lines[2:], start=3):
        parts = line.split("\t")
        if len(parts) != 3 or not parts[0] or parts[1] not in MATCH_KINDS or not parts[2].split():
            raise SetupError(f"{GENERATED} line {number}: malformed; {REFRESH}", line=number)
        entries.append(Entry(parts[0], parts[2], parts[1]))
    return lines[1][len(SOURCE_PREFIX) :], entries


def parse_manual(text: str) -> list[Entry]:
    """`denylist.txt`, exactly as `energatron.services.denylist.parse_manual_denylist` parses it (P0.2.5).

    Lines split on `\\n` only, one trailing `\\r` dropped (form feed, U+2028 and a lone `\\r` stay inside a line);
    each line `str.strip()`ped; blank lines and lines starting with `#` skipped (no inline comments); `word:` makes
    a whole-word entry, the rest stripped again; labels `manual:<line number>`; an empty entry, or a substring entry
    under 5 characters after `" ".join(value.split())`, is a malformed line, named by its number only.
    """
    entries: list[Entry] = []
    for number, line in enumerate(text.split("\n"), start=1):
        stripped = line.removesuffix("\r").strip()
        if not stripped or stripped.startswith("#"):
            continue
        match, value = "substring", stripped
        if stripped.startswith(WORD_PREFIX):
            match, value = "word", stripped[len(WORD_PREFIX) :].strip()
        if not value:
            raise SetupError(f"{MANUAL} line {number}: an empty entry", line=number)
        if match == "substring" and len(" ".join(value.split())) < WORD_MIN_SUBSTRING:
            raise SetupError(
                f"{MANUAL} line {number}: a substring entry needs at least {WORD_MIN_SUBSTRING} characters; "
                "prefix it with `word:` for a whole-word match",
                line=number,
            )
        entries.append(Entry(f"manual:{number}", value, match))
    return entries


def load_denylist(directory: Path) -> list[Entry]:
    """The generated entries, checked against `config.toml`'s sha256 when it's there, plus `denylist.txt`'s."""
    generated = _read(directory / GENERATED, missing=f"{GENERATED} is missing; {REFRESH}")
    assert generated is not None
    source, entries = parse_generated(_decode(generated, GENERATED))
    config = _read(directory / CONFIG, missing=None)
    if config is not None and hashlib.sha256(config).hexdigest() != source:
        raise SetupError(f"the denylist is stale; {REFRESH}")
    manual = _read(directory / MANUAL, missing=None)
    if manual is not None:
        entries += parse_manual(_decode(manual, MANUAL))
    return entries


def _read(path: Path, *, missing: str | None) -> bytes | None:
    try:
        return path.read_bytes()
    except FileNotFoundError:
        if missing is None:
            return None
        raise SetupError(missing) from None
    except OSError:
        raise SetupError(f"the denylist directory's {path.name} can't be read") from None


def _decode(data: bytes, name: str) -> str:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise SetupError(f"{name} is not UTF-8") from None


# Matching


def entry_pattern(entry: Entry) -> str:
    """The entry's regex body: literal parts joined by `\\s+`, with word edges for a `word` entry."""
    body = r"\s+".join(re.escape(part) for part in entry.value.split())
    if entry.match == "word":
        return f"{_WORD_EDGE_BEFORE}{body}{_WORD_EDGE_AFTER}"
    return body


class Matcher:
    """Finds and redacts denylist entries, as `energatron.core.privacy.redact` does."""

    def __init__(self, entries: list[Entry]) -> None:
        self.entries = list(entries)
        # Lookaheads, so `finditer` finds a match at every start, overlapping or not.
        self._finders = [
            (entry.label, re.compile(f"(?=({entry_pattern(entry)}))", re.IGNORECASE)) for entry in self.entries
        ]
        bodies = "|".join(f"(?:{entry_pattern(entry)})" for entry in self.entries)
        self._any = re.compile(bodies, re.IGNORECASE) if self.entries else None

    def hits(self, text: str) -> list[tuple[int, str]]:
        """Sorted, unique `(line number, label)` pairs for every match in `text`."""
        if self._any is None or self._any.search(text) is None:
            return []
        newlines = [found.start() for found in _NEWLINE.finditer(text)]
        found_hits: set[tuple[int, str]] = set()
        for label, finder in self._finders:
            for found in finder.finditer(text):
                if found.end(1) > found.start(1):
                    found_hits.add((bisect.bisect_left(newlines, found.start(1)) + 1, label))
        return sorted(found_hits)

    def labels(self, text: str) -> list[str]:
        """The sorted labels of the entries that match `text`."""
        return sorted({label for _, label in self.hits(text)})

    def content_hits(self, data: bytes) -> list[tuple[int, str]]:
        """`hits` in `data` decoded as UTF-8 (`errors="replace"`) and, when it holds NUL bytes, also with them removed.

        Removing the NULs turns UTF-16 text (LE or BE, with or without a BOM) holding ASCII back into ASCII, so an
        identifier in it is found; a line break stays a line break, so line numbers agree.
        """
        found = set(self.hits(data.decode("utf-8", errors="replace")))
        if b"\0" in data:
            found.update(self.hits(data.replace(b"\0", b"").decode("utf-8", errors="replace")))
        return sorted(found)

    def content_labels(self, data: bytes) -> list[str]:
        """The sorted labels of `content_hits`."""
        return sorted({label for _, label in self.content_hits(data)})

    def redact(self, text: str) -> str:
        """`text` with each run of matched characters replaced by one `<redacted>`, repeated until nothing changes."""
        if self._any is None:
            return text
        for _ in range(_MAX_PASSES):
            redacted = self._redact_once(text)
            if redacted == text:
                break
            text = redacted
        return text

    def _redact_once(self, text: str) -> str:
        spans = sorted(
            (found.start(1), found.end(1))
            for _, finder in self._finders
            for found in finder.finditer(text)
            if found.end(1) > found.start(1)
        )
        pieces: list[str] = []
        position = 0
        run_end = -1
        for start, end in spans:
            if start > run_end:
                pieces.append(text[position:start])
                pieces.append(REDACTED)
            run_end = max(run_end, end)
            position = run_end
        pieces.append(text[position:])
        return "".join(pieces)


# Rules on paths and content


def path_problems(path: str, mode: str) -> list[str]:
    """The path rules of D2 §7.4 that `path` (repo-relative, POSIX) breaks."""
    parts = path.split("/")
    name = parts[-1].lower()
    top = parts[0] if len(parts) > 1 else ""
    problems: list[str] = []
    suffix = "." + name.rsplit(".", 1)[1] if "." in name else ""
    if suffix in DATA_SUFFIXES and not _data_allowed(path, mode):
        problems.append("data file type outside tests/fixtures/ (and the other allowed places)")
    if mode == "tool":
        if (
            name.endswith(".dvc")
            or name == "dvc.lock"
            or ".dvc" in parts[:-1]
            or (name == "dvc.yaml" and not path.startswith("tests/fixtures/"))
        ):
            problems.append("DVC file in the tool repo")
        if top in ("data", "private", "legacy"):
            problems.append("top-level data/, private/ or legacy/ path in the tool repo")
        if name.endswith(".ipynb"):
            problems.append("notebook in the tool repo")
    else:
        if top == "data" and not (name.endswith(".dvc") or name == ".gitignore"):
            problems.append("data/ path that isn't a .dvc pointer or .gitignore")
        if top in ("private", "legacy", ".venv"):
            problems.append("private/, legacy/ or .venv/ path")
        if path in (".energatron/local.toml", ".energatron/lock") or path.startswith(".energatron/tmp/"):
            problems.append("machine-local .energatron/ file")
    return problems


def _data_allowed(path: str, mode: str) -> bool:
    if path.startswith("tests/fixtures/") or path == ".claude/settings.json":
        return True
    return mode == "workspace" and (
        path.startswith("config/") or path in (".energatron/code_fingerprint.json", ".energatron/template.json")
    )


def notebook_problem(content: bytes) -> str | None:
    """Why a notebook can't be committed: outputs or execution counts in a cell, or it isn't a notebook."""
    try:
        notebook = json.loads(content.decode("utf-8"))
    except ValueError:
        return "notebook that can't be parsed"
    cells = notebook.get("cells") if isinstance(notebook, dict) else None
    if not isinstance(cells, list):
        return "notebook that can't be parsed"
    for cell in cells:
        if isinstance(cell, dict) and (cell.get("outputs") or cell.get("execution_count") is not None):
            return "notebook with outputs or execution counts; strip it"
    return None


def figure_counts(text: str) -> tuple[int, int, int]:
    """Counts of energy figures, money figures and 4-digit numbers outside 1900-2099 (D2 §7.1)."""
    energy = _energy_count(text)
    money = sum(1 for _ in _MONEY.finditer(text))
    four = sum(1 for found in _FOUR_DIGITS.finditer(text) if not 1900 <= int(found.group()) <= 2099)
    return energy, money, four


def _energy_count(text: str) -> int:
    """How many matches `re.finditer(ENERGY_PATTERN, text)` finds, in linear time.

    The pattern itself backtracks quadratically on a long digit run. A match can only start at the first digit of a
    maximal run of digits and commas (from a later digit the rest is the same, and giving digits back to `[\\d,]*`
    never helps), and it matches exactly when the run's end is followed by the pattern's tail.
    """
    count = 0
    last_end = 0
    for run in _DIGIT_RUN.finditer(text):
        if run.start() < last_end or not any(character.isdigit() for character in run.group()):
            continue
        tail = _ENERGY_TAIL.match(text, run.end())
        if tail is not None:
            count += 1
            last_end = tail.end()
    return count


# Git


def git(root: str, *args: str, stdin: bytes | None = None, ok: tuple[int, ...] = (0,)) -> tuple[int, bytes]:
    try:
        done = subprocess.run(["git", *args], cwd=root, input=stdin, capture_output=True)
    except OSError:
        raise SetupError("git can't be run") from None
    if done.returncode not in ok:
        raise SetupError(f"git {args[0]} failed (exit {done.returncode})")
    return done.returncode, done.stdout


def git_root() -> str | None:
    """The work tree's root, or None outside a git repo."""
    try:
        done = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True)
    except OSError:
        return None
    if done.returncode != 0:
        return None
    return os.fsdecode(done.stdout.rstrip(b"\n"))


@dataclass
class Item:
    """One path to check: its repo-relative POSIX path, `regular`, `symlink` or `gitlink`, and its content."""

    path: str
    kind: str
    content: bytes = field(default=b"", repr=False)


def index_entries(root: str) -> list[tuple[str, str, str]]:
    """`(mode, object, path)` for every index entry, as `git ls-files --stage` lists them."""
    _, out = git(root, "ls-files", "--stage", "-z")
    entries: list[tuple[str, str, str]] = []
    for record in out.split(b"\0"):
        if not record:
            continue
        meta, _, path = record.partition(b"\t")
        mode, obj, _stage = meta.decode("ascii").split(" ")
        entries.append((mode, obj, os.fsdecode(path)))
    return entries


def staged_paths(root: str) -> set[str]:
    # `--ignore-submodules=none`: `diff.ignoreSubmodules` or a `.gitmodules` `ignore = all` must not hide a gitlink.
    _, out = git(
        root, "diff", "--cached", "--name-only", "-z", "--no-renames", "--diff-filter=ACMRT", "--ignore-submodules=none"
    )
    return {os.fsdecode(path) for path in out.split(b"\0") if path}


def index_items(root: str, wanted: set[str] | None) -> list[Item]:
    """Items from the index (all, or the `wanted` paths), with their content read with `git cat-file --batch`."""
    items: list[Item] = []
    blobs: list[tuple[Item, str]] = []
    seen: set[tuple[str, str]] = set()
    for mode, obj, path in index_entries(root):
        if (wanted is not None and path not in wanted) or (path, obj) in seen:
            continue
        seen.add((path, obj))
        kind = {"160000": "gitlink", "120000": "symlink"}.get(mode, "regular")
        item = Item(path, kind)
        items.append(item)
        if kind != "gitlink":
            blobs.append((item, obj))
    contents = read_objects(root, [obj for _, obj in blobs])
    for index, (item, _obj) in enumerate(blobs):
        item.content = contents[index]
    return items


def read_objects(root: str, objects: list[str]) -> list[bytes]:
    """The content of each object, in order, read with one `git cat-file --batch`."""
    if not objects:
        return []
    _, out = git(root, "cat-file", "--batch", stdin="".join(f"{obj}\n" for obj in objects).encode("ascii"))
    contents: list[bytes] = []
    position = 0
    for _obj in objects:
        header_end = out.index(b"\n", position)
        header = out[position:header_end].split(b" ")
        if len(header) != 3:
            raise SetupError("git cat-file couldn't read an object")
        size = int(header[2])
        contents.append(out[header_end + 1 : header_end + 1 + size])
        position = header_end + 1 + size + 1
    return contents


# Running


class Reporter:
    """Writes every line through the matcher, so nothing printed holds a denylist value."""

    def __init__(self, matcher: Matcher, *, figures: bool) -> None:
        self.matcher = matcher
        self.figures_on = figures
        self.violations = 0
        self.flagged: set[str] = set()
        self.figures: list[tuple[str, tuple[int, int, int]]] = []

    def violation(self, key: str, text: str) -> None:
        self.violations += 1
        self.flagged.add(key)
        self.err(text)

    def err(self, text: str) -> None:
        print(f"privacy_guard: {self.matcher.redact(text)}", file=sys.stderr, flush=True)

    def out(self, text: str) -> None:
        print(f"privacy_guard: {self.matcher.redact(text)}", file=sys.stdout, flush=True)

    def figure(self, shown: str, text: str) -> None:
        if self.figures_on:
            self.figures.append((shown, figure_counts(text)))

    def finish(self, checked: int, unit: str, *, also: str = "") -> int:
        """Print the figures (when asked) and the summary, `… of <checked> <unit>s<also>`; the exit code."""
        if self.figures_on:
            for shown, (energy, money, four) in self.figures:
                if energy or money or four:
                    self.out(f"figures: {shown}: energy {energy}, money {money}, four-digit {four}")
            totals = [sum(counts[index] for _, counts in self.figures) for index in range(3)]
            self.out(
                f"figures total: energy {totals[0]}, money {totals[1]}, four-digit {totals[2]} "
                f"in {_counted(len(self.figures), unit)}"
            )
        noun = "violation" if self.violations == 1 else "violations"
        self.err(f"{self.violations} {noun} in {len(self.flagged)} of {_counted(checked, unit)}{also}")
        return 1 if self.violations else 0


def _counted(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def check_item(
    item: Item, mode: str, reporter: Reporter, *, key: str | None = None, prefix: str = "", content: bool = True
) -> None:
    """The path rules, and (with `content`) the size, denylist-content and notebook rules, for one item.

    `key` is what a violation counts against in the summary (the path by default, the commit in `--history`).
    """
    matcher = reporter.matcher
    shown = matcher.redact(item.path)
    key = item.path if key is None else key
    for label in matcher.labels(item.path):
        reporter.violation(key, f"{prefix}{shown}: denylist hit in path ({label})")
    if item.kind == "gitlink":
        reporter.violation(key, f"{prefix}{shown}: gitlink (submodule)")
        return
    for problem in path_problems(item.path, mode):
        reporter.violation(key, f"{prefix}{shown}: {problem}")
    if not content:
        return
    if len(item.content) > MAX_BYTES:
        reporter.violation(key, f"{shown}: file over 5 MiB")
    text = item.content.decode("utf-8", errors="replace")
    for line, label in matcher.content_hits(item.content):
        reporter.violation(key, f"{shown}:{line}: denylist hit ({label})")
    if mode == "workspace" and item.kind == "regular" and item.path.lower().endswith(".ipynb"):
        problem = notebook_problem(item.content)
        if problem is not None:
            reporter.violation(key, f"{shown}: {problem}")
    reporter.figure(shown, text)


def check_history(root: str, mode: str, reporter: Reporter) -> tuple[int, int]:
    """Every commit reachable from any ref, then every ref; returns how many commits and refs were checked.

    A commit: the denylist on its message, its patch and the whole new content of each added or changed path (the
    patch's line prefixes break a match across lines), the path rules on those paths. A ref: the denylist on its
    name and on every annotated tag object it reaches, down a chain of tags.
    """
    matcher = reporter.matcher
    _, out = git(root, "rev-list", "--all")
    commits = [line for line in out.decode("ascii").split("\n") if line]
    diff = ("diff-tree", "-r", "--root", "-m", "--no-renames", "--no-commit-id", "--ignore-submodules=none")
    for commit in commits:
        short = commit[:7]
        key = f"commit {commit}"
        _, message_bytes = git(root, "show", "-s", "--format=%B", commit)
        message = message_bytes.decode("utf-8", errors="replace")
        for label in matcher.content_labels(message_bytes):
            reporter.violation(key, f"commit {short}: denylist hit in message ({label})")
        _, patch_bytes = git(root, *diff, "-p", "--text", "--no-color", "--no-ext-diff", "--no-textconv", commit)
        patch = patch_bytes.decode("utf-8", errors="replace")
        for label in matcher.content_labels(patch_bytes):
            reporter.violation(key, f"commit {short}: denylist hit in patch ({label})")
        _, raw = git(root, *diff, "-z", "--raw", commit)
        fields = raw.split(b"\0")
        changed: dict[str, tuple[str, str]] = {}
        for index in range(0, len(fields) - 1, 2):
            meta = fields[index].decode("ascii").lstrip(":").split(" ")
            if len(meta) == 5 and meta[4] != "D":
                changed[os.fsdecode(fields[index + 1])] = (meta[1], meta[3])
        blobs: list[tuple[str, str]] = []
        for path, (new_mode, obj) in sorted(changed.items()):
            kind = "gitlink" if new_mode == "160000" else "regular"
            check_item(Item(path, kind), mode, reporter, key=key, prefix=f"commit {short}: ", content=False)
            if kind != "gitlink":
                blobs.append((path, obj))
        contents = read_objects(root, [obj for _, obj in blobs])
        for index, (path, _obj) in enumerate(blobs):
            for line, label in matcher.content_hits(contents[index]):
                reporter.violation(key, f"commit {short}: {matcher.redact(path)}:{line}: denylist hit ({label})")
        reporter.figure(f"commit {short}", f"{message}\n{patch}")
    refs = check_refs(root, reporter)
    return len(commits), refs


def check_refs(root: str, reporter: Reporter) -> int:
    """The denylist on every ref name and on every annotated tag object a ref reaches; returns the number of refs."""
    matcher = reporter.matcher
    _, out = git(root, "for-each-ref", "--format=%(objectname) %(objecttype) %(refname)")
    lines = [line for line in os.fsdecode(out).split("\n") if line]
    for line in lines:
        obj, kind, name = line.split(" ", 2)
        key = f"ref {name}"
        shown = f"ref {matcher.redact(name)}"
        for label in matcher.labels(name):
            reporter.violation(key, f"{shown}: denylist hit in ref name ({label})")
        seen: set[str] = set()
        tag_labels: set[str] = set()
        while kind == "tag" and obj not in seen:
            seen.add(obj)
            (tag,) = read_objects(root, [obj])
            tag_labels.update(matcher.content_labels(tag))
            header = tag.split(b"\n\n", 1)[0].decode("utf-8", errors="replace").split("\n")
            fields = dict(field.split(" ", 1) for field in header if " " in field)
            obj, kind = fields.get("object", ""), fields.get("type", "")
        for label in sorted(tag_labels):
            reporter.violation(key, f"{shown}: denylist hit in annotated tag ({label})")
    return len(lines)


def path_items(paths: list[str], root: str) -> list[Item]:
    """Working-tree items: a symlink's content is its target text; the file it points to is never read."""
    real_root = os.path.realpath(root)
    items: list[Item] = []
    for number, given in enumerate(paths, start=1):
        absolute = os.path.abspath(given)
        try:
            info = os.lstat(absolute)
            if stat.S_ISLNK(info.st_mode):
                kind, content = "symlink", os.fsencode(os.readlink(absolute))
            elif stat.S_ISREG(info.st_mode):
                kind, content = "regular", Path(absolute).read_bytes()
            else:
                raise SetupError(f"path argument {number} is not a file")
        except OSError:
            raise SetupError(f"path argument {number} doesn't exist or can't be read") from None
        located = os.path.join(os.path.realpath(os.path.dirname(absolute)), os.path.basename(absolute))
        relative = os.path.relpath(located, real_root).replace(os.sep, "/")
        items.append(Item(relative, kind, content))
    return items


def denylist_directory(args: argparse.Namespace, root: str | None, cwd: str) -> Path | None:
    """Where the denylist lives (D2 §7.2), or None when it's skipped."""
    if args.no_denylist:
        return None
    if args.denylist_dir is not None:
        return Path(args.denylist_dir)
    if args.mode == "workspace":
        return Path(root or cwd) / "private"
    if root is None:
        raise SetupError(
            "not in a git repo, so `git config energatron.denylist` can't be read: pass --denylist-dir DIR or "
            "--no-denylist"
        )
    code, out = git(root, "config", "--get", "energatron.denylist", ok=(0, 1))
    value = os.fsdecode(out).strip()
    if code == 1 or not value:
        raise SetupError(
            "no denylist is set: run `git config energatron.denylist <dir>` with the workspace's private/ folder, "
            "relative to the repo root, or `git config energatron.denylist none` to run without one"
        )
    if value == "none":
        return None
    return Path(root) / value


class _Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:  # argparse's own text can echo what was typed
        raise SetupError("bad arguments; see --help")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = _Parser(
        prog="privacy_guard.py",
        description="Block personal identifiers and private data from reaching git (D2 §7).",
    )
    parser.add_argument("--mode", choices=("tool", "workspace"), required=True)
    parser.add_argument("--staged", action="store_true", help="check the index's added and changed paths")
    parser.add_argument("--commit-msg", metavar="FILE", help="check a commit message")
    parser.add_argument("--tracked", action="store_true", help="check every path in the index")
    parser.add_argument("--history", action="store_true", help="check every commit reachable from any ref")
    parser.add_argument("paths", nargs="*", metavar="PATH", help="check these working-tree files")
    where = parser.add_mutually_exclusive_group()
    where.add_argument("--denylist-dir", metavar="DIR", help="the denylist directory (overrides the default)")
    where.add_argument("--no-denylist", action="store_true", help="skip the denylist rules")
    parser.add_argument("--figures", action="store_true", help="also print counts of figures (never the figures)")
    args = parser.parse_intermixed_args(argv)
    sources = [args.staged, args.commit_msg is not None, args.tracked, args.history, bool(args.paths)]
    if sum(sources) != 1:
        raise SetupError("give exactly one of --staged, --commit-msg, --tracked, --history or paths; see --help")
    return args


def run(args: argparse.Namespace) -> int:
    cwd = os.getcwd()
    root = git_root()
    if root is None and not args.paths and args.commit_msg is None:
        raise SetupError("not in a git repo")
    directory = denylist_directory(args, root, cwd)
    entries = load_denylist(directory) if directory is not None else []
    reporter = Reporter(Matcher(entries), figures=args.figures)
    if args.commit_msg is not None:
        try:
            message_bytes = Path(args.commit_msg).read_bytes()
        except OSError:
            raise SetupError("the commit message file can't be read") from None
        message = message_bytes.decode("utf-8", errors="replace")
        for line, label in reporter.matcher.content_hits(message_bytes):
            reporter.violation("message", f"commit message:{line}: denylist hit ({label})")
        reporter.figure("commit message", message)
        return reporter.finish(1, "commit message")
    if args.history:
        assert root is not None
        commits, refs = check_history(root, args.mode, reporter)
        return reporter.finish(commits, "commit", also=f" and {_counted(refs, 'ref')}")
    if args.paths:
        items = path_items(args.paths, root or cwd)
    else:
        assert root is not None
        items = index_items(root, staged_paths(root) if args.staged else None)
    for item in items:
        check_item(item, args.mode, reporter)
    return reporter.finish(len(items), "path")


def main(argv: list[str] | None = None) -> int:
    try:
        return run(parse_args(sys.argv[1:] if argv is None else argv))
    except SetupError as error:
        print(f"privacy_guard: setup error: {error}", file=sys.stderr, flush=True)
        return 2


if __name__ == "__main__":
    sys.exit(main())
